      {
        "name": "_KeyRateMapping",
        "columns": [
          {
            "name": "KeyRateBucket",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isKey": true,
            "isNameInferred": true,
            "lineageTag": "f79aaf65-fe32-47da-a4e5-611bdd247beb",
            "sourceColumn": "[KeyRateBucket]",
            "type": "calculatedTableColumn"
          },
          {
            "name": "TenorLabel",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "76f1ee41-0fe9-4412-9bb0-4e88d83e1723",
            "sourceColumn": "[TenorLabel]",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Tenor_Years",
            "dataType": "double",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "0b61d9f4-bce7-4795-aa42-a3bc365fd95c",
            "sourceColumn": "[Tenor_Years]",
            "type": "calculatedTableColumn"
          },
          {
            "name": "BucketOrder",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "e35ad70e-99c7-4b53-8e70-38aba76f4184",
            "sourceColumn": "[BucketOrder]",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "41ae3a59-fb4b-401b-94ca-e8271d48177f",
        "partitions": [
          {
            "name": "_KeyRateMapping-Partition",
            "mode": "import",
            "source": {
              "expression": [
                "DATATABLE(",
                "    \"KeyRateBucket\", STRING,",
                "    \"TenorLabel\", STRING,",
                "    \"Tenor_Years\", DOUBLE,",
                "    \"BucketOrder\", INTEGER,",
                "    {",
                "        {\"0-1Y\", \"1Y\", 1.0, 1},",
                "        {\"1-2Y\", \"2Y\", 2.0, 2},",
                "        {\"2-3Y\", \"3Y\", 3.0, 3},",
                "        {\"3-5Y\", \"5Y\", 5.0, 4},",
                "        {\"5-7Y\", \"7Y\", 7.0, 5},",
                "        {\"7-10Y\", \"10Y\", 10.0, 6},",
                "        {\"10-15Y\", \"15Y\", 15.0, 7},",
                "        {\"15-20Y\", \"20Y\", 20.0, 8},",
                "        {\"20Y+\", \"30Y\", 30.0, 9}",
                "    }",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      },
      {
        "name": "RateShockParameter",
        "columns": [
          {
            "name": "ScenarioName",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "1eed1173-58b7-4819-bee0-94db38af58cc",
            "sourceColumn": "[ScenarioName]",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Shock_bps",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "e1e892f0-b538-4609-a1c3-0ff8466bf8e6",
            "sourceColumn": "[Shock_bps]",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Direction",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "6ebebcc9-242c-461d-9394-238e7284a3f2",
            "sourceColumn": "[Direction]",
            "type": "calculatedTableColumn"
          },
          {
            "name": "SortOrder",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "ee10de08-6f62-476c-b37a-a90087342527",
            "sourceColumn": "[SortOrder]",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "86f08850-48b2-4c0b-a999-e46cde7f1dfa",
        "partitions": [
          {
            "name": "RateShockParameter-Partition",
            "mode": "import",
            "source": {
              "expression": [
                "DATATABLE(",
                "    \"ScenarioName\", STRING,",
                "    \"Shock_bps\", INTEGER,",
                "    \"Direction\", STRING,",
                "    \"SortOrder\", INTEGER,",
                "    {",
                "        {\"Rate Shock -200 bps\", -200, \"Downward\", 1},",
                "        {\"Rate Shock -100 bps\", -100, \"Downward\", 2},",
                "        {\"Rate Shock  -50 bps\",  -50, \"Downward\", 3},",
                "        {\"Rate Shock  +50 bps\",   50, \"Upward\",   4},",
                "        {\"Rate Shock +100 bps\",  100, \"Upward\",   5},",
                "        {\"Rate Shock +200 bps\",  200, \"Upward\",   6}",
                "    }",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "MeasureCategory",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isHidden": true,
            "isNameInferred": true,
            "lineageTag": "944ce045-df11-4c6c-bb7a-35b8e06ac031",
            "sourceColumn": "[MeasureCategory]",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "37858ff8-c86b-4917-9937-19b3d31b2896",
        "measures": [
          {
            "name": "Total Bonds",
            "expression": "COUNTROWS('bond_portfolio_data')",
            "formatString": "#,0",
            "lineageTag": "648aebaa-c882-4b82-a629-ba7708480624"
          },
          {
            "name": "Total Portfolio Market Value",
            "expression": "SUM('bond_portfolio_data'[MarketValue_INR])",
            "formatString": "₹#,0.00",
            "lineageTag": "aefe4745-c67b-4da2-a0c0-b2c6f680e25a"
          },
          {
            "name": "Average Coupon Rate",
            "expression": "AVERAGE('bond_portfolio_data'[CouponRate])",
            "formatString": "0.0000%",
            "lineageTag": "4d13b1b4-1ead-4c8a-95aa-2d5d3dac0dd6"
          },
          {
            "name": "Weighted Average Coupon Rate",
            "expression": "DIVIDE(SUMX('bond_portfolio_data', 'bond_portfolio_data'[CouponRate] * 'bond_portfolio_data'[MarketValue_INR]), [Total Portfolio Market Value], 0)",
            "formatString": "0.0000%",
            "lineageTag": "6a8a99d9-01f9-4237-b5c5-d3cb5818c244"
          },
          {
            "name": "Portfolio Weight %",
            "expression": "DIVIDE([Total Portfolio Market Value], CALCULATE([Total Portfolio Market Value], ALL('bond_portfolio_data')), 0)",
            "formatString": "0.00%",
            "lineageTag": "ae9b1734-a472-449d-a333-a58761b993c5"
          },
          {
            "name": "Issuer Exposure %",
            "expression": "DIVIDE(SUM('bond_portfolio_data'[MarketValue_INR]), CALCULATE(SUM('bond_portfolio_data'[MarketValue_INR]), ALLSELECTED('bond_portfolio_data')), 0)",
            "formatString": "0.00%",
            "lineageTag": "fc6c7d56-d68d-4cb5-aa77-0972973a992e"
          },
          {
            "name": "Bond Type Exposure %",
            "expression": "DIVIDE(SUM('bond_portfolio_data'[MarketValue_INR]), CALCULATE(SUM('bond_portfolio_data'[MarketValue_INR]), ALLSELECTED('bond_portfolio_data')), 0)",
            "formatString": "0.00%",
            "lineageTag": "2813f793-c78e-47e1-951b-3d511e0f47a1"
          },
          {
            "name": "Portfolio Effective Duration",
            "expression": "DIVIDE(SUMX('bond_portfolio_data', 'bond_portfolio_data'[EffectiveDuration] * 'bond_portfolio_data'[MarketValue_INR]), [Total Portfolio Market Value], 0)",
            "formatString": "0.0000",
            "lineageTag": "d4e3e6ac-4cd8-4fb2-94fc-2a0d0216e1cd"
          },
          {
            "name": "Portfolio Effective Convexity",
            "expression": "DIVIDE(SUMX('bond_portfolio_data', 'bond_portfolio_data'[EffectiveConvexity] * 'bond_portfolio_data'[MarketValue_INR]), [Total Portfolio Market Value], 0)",
            "formatString": "0.0000",
            "lineageTag": "5873073a-9db7-409d-8486-de8313a7277e"
          },
          {
            "name": "Total DV01",
            "expression": "SUMX('bond_portfolio_data', 'bond_portfolio_data'[DV01_Per100Face] * ('bond_portfolio_data'[Quantity] * 'bond_portfolio_data'[FaceValue] / 100))",
            "formatString": "₹#,0.00",
            "lineageTag": "b02f80b4-b60e-47b2-a007-fa50af28baf5"
          },
          {
            "name": "Estimated Price Shock Impact INR",
            "expression": [
              "",
              "VAR ShockChoice =",
              "    SELECTEDVALUE('RateShockParameter'[Shock_bps], 100)",
              "RETURN",
              "SWITCH(",
              "    ShockChoice,",
              "    -200,",
              "        SUMX(",
              "            'bond_portfolio_data',",
              "            DIVIDE(",
              "                'bond_portfolio_data'[PriceChange_Dn200bps],",
              "                'bond_portfolio_data'[CleanPrice],",
              "                0",
              "            ) * 'bond_portfolio_data'[MarketValue_INR]",
              "        ),",
              "    -100,",
              "        SUMX(",
              "            'bond_portfolio_data',",
              "            DIVIDE(",
              "                'bond_portfolio_data'[PriceChange_Dn100bps],",
              "                'bond_portfolio_data'[CleanPrice],",
              "                0",
              "            ) * 'bond_portfolio_data'[MarketValue_INR]",
              "        ),",
              "    -50,",
              "        SUMX(",
              "            'bond_portfolio_data',",
              "            DIVIDE(",
              "                'bond_portfolio_data'[PriceChange_Dn50bps],",
              "                'bond_portfolio_data'[CleanPrice],",
              "                0",
              "            ) * 'bond_portfolio_data'[MarketValue_INR]",
              "        ),",
              "    50,",
              "        SUMX(",
              "            'bond_portfolio_data',",
              "            DIVIDE(",
              "                'bond_portfolio_data'[PriceChange_Up50bps],",
              "                'bond_portfolio_data'[CleanPrice],",
              "                0",
              "            ) * 'bond_portfolio_data'[MarketValue_INR]",
              "        ),",
              "    100,",
              "        SUMX(",
              "            'bond_portfolio_data',",
              "            DIVIDE(",
              "                'bond_portfolio_data'[PriceChange_Up100bps],",
              "                'bond_portfolio_data'[CleanPrice],",
              "                0",
              "            ) * 'bond_portfolio_data'[MarketValue_INR]",
              "        ),",
              "    200,",
              "        SUMX(",
              "            'bond_portfolio_data',",
              "            DIVIDE(",
              "                'bond_portfolio_data'[PriceChange_Up200bps],",
              "                'bond_portfolio_data'[CleanPrice],",
              "                0",
              "            ) * 'bond_portfolio_data'[MarketValue_INR]",
              "        ),",
              "    0",
              ")",
              ""
            ],
            "formatString": "₹#,0.00",
            "lineageTag": "be24a814-4241-4736-b911-0996a96a54c6"
          },
          {
            "name": "Price Shock Portfolio Return %",
            "expression": "DIVIDE([Estimated Price Shock Impact INR], [Total Portfolio Market Value], 0)",
            "formatString": "+0.00%;-0.00%;0.00%",
            "lineageTag": "4f55dc6f-7fc0-42e3-8ba7-d03476a3ff98"
          },
          {
            "name": "Simulated Duration P&L",
            "expression": "SUM('monte_carlo_scenarios'[PnL_DurationEffect_INR])",
            "formatString": "₹#,0.00",
            "lineageTag": "a70c0f97-2aa1-493f-933b-e0abb692b259"
          },
          {
            "name": "Simulated Convexity P&L",
            "expression": "SUM('monte_carlo_scenarios'[PnL_ConvexityEffect_INR])",
            "formatString": "₹#,0.00",
            "lineageTag": "681a561d-065e-40f4-a88b-98d9347d69e6"
          },
          {
            "name": "Simulated Total P&L",
            "expression": "SUM('monte_carlo_scenarios'[PnL_Total_INR])",
            "formatString": "₹#,0.00",
            "lineageTag": "fcf60ec2-b79b-4b1a-8e3e-a58eeeb2c84b"
          },
          {
            "name": "Average Scenario P&L",
            "expression": "AVERAGE('monte_carlo_scenarios'[PnL_Total_INR])",
            "formatString": "₹#,0.00",
            "lineageTag": "07e066ae-5cbd-41b4-a637-ca362b9aa739"
          },
          {
            "name": "95% VaR (INR)",
            "expression": "PERCENTILE.INC('monte_carlo_scenarios'[PnL_Total_INR], 0.05)",
            "formatString": "₹#,0.00",
            "lineageTag": "127baab5-e5cd-4549-9a6d-24ce9a7d6a4d"
          },
          {
            "name": "95% VaR (%)",
            "expression": "PERCENTILE.INC('monte_carlo_scenarios'[PnL_Pct], 0.05)",
            "formatString": "-0.00%",
            "lineageTag": "eb71406b-4b3e-4e5f-8a25-7aee63be0e5e"
          },
          {
            "name": "99% VaR (INR)",
            "expression": "PERCENTILE.INC('monte_carlo_scenarios'[PnL_Total_INR], 0.01)",
            "formatString": "₹#,0.00",
            "lineageTag": "863603fa-9edf-47f0-a1e2-622ad9e1bcba"
          },
          {
            "name": "99% VaR (%)",
            "expression": "PERCENTILE.INC('monte_carlo_scenarios'[PnL_Pct], 0.01)",
            "formatString": "-0.00%",
            "lineageTag": "bf51209d-54f9-42a6-9460-f3b0c31a9f99"
          },
          {
            "name": "95% Expected Shortfall (INR)",
            "expression": [
              "VAR VaR95 = [95% VaR (INR)]",
              "RETURN",
              "CALCULATE(AVERAGE('monte_carlo_scenarios'[PnL_Total_INR]), 'monte_carlo_scenarios'[PnL_Total_INR] <= VaR95)"
            ],
            "formatString": "₹#,0.00",
            "lineageTag": "db47031d-d527-43d2-aa97-078d674dd1e4"
          },
          {
            "name": "99% Expected Shortfall (INR)",
            "expression": [
              "VAR VaR99 = [99% VaR (INR)]",
              "RETURN",
              "CALCULATE(AVERAGE('monte_carlo_scenarios'[PnL_Total_INR]), 'monte_carlo_scenarios'[PnL_Total_INR] <= VaR99)"
            ],
            "formatString": "₹#,0.00",
            "lineageTag": "2ece42fd-a94a-43be-a9a7-4590159a6229"
          },
          {
            "name": "Average Yield to Maturity",
            "expression": "AVERAGE('bond_portfolio_data'[YieldToMaturity])",
            "formatString": "0.0000%",
            "lineageTag": "819df522-abb5-4e10-b5a8-db4ea54d9b34"
          },
          {
            "name": "Weighted Average YTM",
            "expression": "DIVIDE(SUMX('bond_portfolio_data', 'bond_portfolio_data'[YieldToMaturity] * 'bond_portfolio_data'[MarketValue_INR]), [Total Portfolio Market Value], 0)",
            "formatString": "0.0000%",
            "lineageTag": "ebc2d24c-25bc-4018-a0fe-b963a006cc5b"
          },
          {
            "name": "Shock_Impact_Dn100bps_INR",
            "expression": [
              "",
              "SUMX(",
              "    'bond_portfolio_data',",
              "    DIVIDE(",
              "        'bond_portfolio_data'[PriceChange_Dn100bps],",
              "        'bond_portfolio_data'[CleanPrice],",
              "        0",
              "    )",
              "    * 'bond_portfolio_data'[MarketValue_INR]",
              ")",
              ""
            ],
            "formatString": "₹#,0.00",
            "lineageTag": "2e86e931-902e-4bc2-9b99-adea4c2b39a2"
          },
          {
            "name": "Shock_Impact_Up100bps_INR",
            "expression": [
              "",
              "SUMX(",
              "    'bond_portfolio_data',",
              "    DIVIDE(",
              "        'bond_portfolio_data'[PriceChange_Up100bps],",
              "        'bond_portfolio_data'[CleanPrice],",
              "        0",
              "    )",
              "    * 'bond_portfolio_data'[MarketValue_INR]",
              ")",
              ""
            ],
            "formatString": "₹#,0.00",
            "lineageTag": "172b4b20-1994-45e1-8fae-1431005b5620"
          }
        ],
